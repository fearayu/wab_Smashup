{
  "name": "wab-smashup-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda/index.mjs",
    "smoke": "esbuild smoke-test.mjs --bundle --platform=node --target=node20 --format=esm --outfile=dist/smoke.mjs --log-level=warning && node dist/smoke.mjs",
    "start:local": "esbuild serve-local.mjs --bundle --platform=node --target=node20 --format=esm --outfile=dist/serve-local.mjs --log-level=warning && node dist/serve-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply wab-smashup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wab-smashup-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@scalar/hono-api-reference": "^0.11.9",
    "hono": "^4.8.0",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
